{
  "name": "auction_house",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tests --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,css}\" \"*.{html,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,css}\" \"*.{html,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=smoke",
    "test:e2e:visual": "playwright test --project=visual",
    "fixtures:check": "node scripts/record-fixtures.mjs --check",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "jsdom": "^27.2.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
